{
    "name": "melvinachterhuis/zero-margin-blocks-shopware6-plugin",
    "description": "Removes Shopware's default 20px margins from CMS blocks",
    "version": "3.1.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Melvin Achterhuis"
        }
    ],
    "require": {
        "shopware/core": "~6.6.10"
    },
    "autoload": {
        "psr-4": {
            "Melv\\ZeroMarginBlocks\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Melv\\ZeroMarginBlocks\\MelvZeroMarginBlocks",
        "label": {
            "de-DE": "CMS-Block-Standardabstände entfernen",
            "en-GB": "Remove default CMS block margins"
        }
    }
}
